# ==============================================================================
# NEMOTRON AXIOM: ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Nebius Token Factory API Configuration
# Get your API key at: https://tokenfactory.nebius.com/
NEBIUS_API_KEY="your-nebius-token-factory-api-key-here"
NEBIUS_BASE_URL="https://api.tokenfactory.nebius.com/v1/"
NEMOTRON_MODEL="nvidia/llama-3.1-nemotron-70b-instruct"

# Tavily AI Search API Configuration (For Live RFC/PEP Concurrency Specifications)
# Get your API key at: https://tavily.com/
TAVILY_API_KEY="your-tavily-search-api-key-here"

# Application Settings
ENVIRONMENT="production"
PORT=8000
DEBUG=false
